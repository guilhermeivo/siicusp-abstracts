% \begin{macro}{\collaborators}
%   \begin{macrocode}
\newcommand*{\collaborators}[1]{\gdef\@collaborators{#1}}
%    \end{macrocode}
% \end{macro}
% \begin{macro}{\advisor}
%   \begin{macrocode}
\newcommand*{\advisor}[1]{\gdef\@advisor{#1}}
%    \end{macrocode}
% \end{macro}
% \begin{macro}{\institution}
%   \begin{macrocode}
\newcommand*{\institution}[1]{\gdef\@institution{#1}}
%    \end{macrocode}
% \end{macro}
% \begin{macro}{\emailauthor}
%   \begin{macrocode}
\newcommand*{\emailauthor}[1]{\gdef\@emailauthor{#1}}
%    \end{macrocode}
% \end{macro}
%
%     \begin{macro}{\cover}
%       Construção da capa.
%    \begin{macrocode}
\renewcommand{\@maketitle}{%
\newpage\null%
\vskip 2em
\begin{center}
    \let\footnote\thanks%
    {\siccusp@thirteenpt\bfseries\MakeUppercase{\@title}\par}
    \vspace{1.2em}
    {\normalfont\siccusp@thirteenpt\bfseries\lineskip .5em
    \begin{tabular}[t]{c}%
        \@author
    \end{tabular}\par}
    \ifdefined\@collaborators
        \vspace{1.2em}
        {\normalfont\siccusp@thirteenpt\bfseries\@collaborators\par}
    \fi
    \vspace{1.2em}
    {\normalfont\siccusp@thirteenpt\bfseries\@advisor\par}
    \vspace{1.2em}
    {\normalfont\siccusp@thirteenpt\@institution\par}
    \vspace{1.2em}
    {\normalfont\small\@emailauthor\par}
    \vspace{0.3em}
\end{center}
\par
\vspace{2em}
}
%    \end{macrocode}
% \end{macro}
%
%     \begin{macro}{\subsubsection}
%       Construção dos títulos das seções, respeitando a hierarquia da formatação das seções.
%    \begin{macrocode}
\renewcommand\section{%
    \@startsection{section}{1}{\z@ }{-3.5ex\@plus -1ex\@minus -.2ex}{2.3ex\@plus .2ex}{\centering\normalfont\siccusp@thirteenpt\bfseries}%
}
%    \end{macrocode}
% \end{macro}
