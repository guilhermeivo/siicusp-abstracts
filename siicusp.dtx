% \begin{macro}{page}
%   Cabeçalho com o logotipo do SIICUSP; sem numeração de página.
%   \begin{macrocode}
\setlength{\headheight}{4.6cm}
\setlength{\headsep}{1.0cm}

\def\ps@headings{%
    \def\@oddhead{\raisebox{-0.9cm}{\includegraphics[height=3.8cm]{logo.png}\hfill}}
    \let\@evenhead\@oddhead
    \def\@oddfoot{}%
    \let\@evenfoot\@oddfoot
}
%    \end{macrocode}
% \end{macro}
