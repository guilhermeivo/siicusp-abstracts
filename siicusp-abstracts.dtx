%   \section{Capa do título}
%
% \begin{macro}{\collaborators}
%   Cada trabalho poderá ter até três colaboradores que tenham participado do desenvolvimento do projeto.
%   \begin{macrocode}
\newcommand*{\collaborators}[1]{\gdef\@collaborators{#1}}
%    \end{macrocode}
% \end{macro}
% \begin{macro}{\advisor}
%   \begin{macrocode}
\newcommand*{\advisor}[1]{\gdef\@advisor{#1}}
%    \end{macrocode}
% \end{macro}
% \begin{macro}{\institution}
%   Unidade e Universidade
%   \begin{macrocode}
\newcommand*{\institution}[1]{\gdef\@institution{#1}}
%    \end{macrocode}
% \end{macro}
% \begin{macro}{\emailauthor}
%   E-mail do primeiro autor
%   \begin{macrocode}
\newcommand*{\emailauthor}[1]{\gdef\@emailauthor{#1}}
%    \end{macrocode}
% \end{macro}
%
%     \begin{macro}{\maketitle}
%       Construção da capa, com ii. Nomes: 13pt, negrito, centralizado; iii. Faculdade/Universidade: 13pt, centralizado; iv. e-mail: 10pt, centralizado (Anexo I);
%    \begin{macrocode}
\renewcommand{\@maketitle}{%
\newpage\null%
\vskip 2em
\begin{center}
    \let\footnote\thanks%
    {\siicuspabstracts@thirteenpt\bfseries\MakeUppercase{\@title}\par}
    \vspace{1.2em}
    {\normalfont\siicuspabstracts@thirteenpt\bfseries\lineskip .5em
    \begin{tabular}[t]{c}%
        \@author
    \end{tabular}\par}
    \ifdefined\@collaborators
        \vspace{1.2em}
        {\normalfont\siicuspabstracts@thirteenpt\bfseries\@collaborators\par}
    \fi
    \vspace{1.2em}
    {\normalfont\siicuspabstracts@thirteenpt\bfseries\@advisor\par}
    \vspace{1.2em}
    {\normalfont\siicuspabstracts@thirteenpt\@institution\par}
    \vspace{1.2em}
    {\normalfont\siicuspabstracts@tenpt\@emailauthor\par}
    \vspace{0.3em}
\end{center}
\par
\vspace{2em}
}
%    \end{macrocode}
% \end{macro}
